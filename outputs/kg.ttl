kg:paper_027
    a onto:Paper ;
    onto:title "Variable Stars in the Fornax Dwarf Galaxy" ;
    onto:abstract "We present the first results of a search for variable stars in the Fornax dwarf galaxy." ;
    onto:doi "10.1017/s0252921100057845" ;
    onto:openAireID "https://explore.openaire.eu/search/publication?pid=10.1017/s0252921100057845" ;
