    onto:hasAuthor kg:person_jing_li_key_laboratory_of_galaxies_and_cosmology_shanghai_eef373dd ;
    onto:hasAuthor kg:person_yong_zhang_nanjing_f1d62add ;
    onto:hasAuthor kg:person_yonghui_hou_nanjing_93ab1c58 ;
